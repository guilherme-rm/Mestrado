{
  "_name": "QoS hypothesis test optimization config",
  "nagents": 4,
  "capacity": 10000,
  "learning_rate": 0.0003,
  "momentum": 0.005,
  "tau": 0.002,
  "batch_size": 128,
  "gamma": 0.97,

  "min_memory_for_learning": 128,
  "action_strategy": "epsilon_greedy",

  "epsilon_policy": "exponential_decay",
  "eps_min": 0.0,
  "eps_max": 0.95,
  "eps_increment": 0.0,
  "eps_start": 1.0,
  "eps_end": 0.02,
  "eps_decay_steps": 40000,

  "nepisodes": 600,
  "nsteps": 40,
  "nupdate": 20,

  "early_termination": true,
  "learn_every": 1,
  "use_amp": true,
  "metrics_interval": 10,
  "diag_interval": 10,
  "parallel_agent_optimization": true,
  "parallel_opt_max_streams": 4,
  "multi_gpu_auto": true,
  "multi_gpu_min_memory_gb": 8.0,
  "batch_size_auto": false,
  "batch_size_vram_fraction": 0.6,
  "batch_size_min": 64,
  "batch_size_max": 4096,
  "batch_size_grad_overhead": 5.0,
  "cuda": 0,

  "enable_plot": true,
  "plot_interval": 50,
  "plot_smooth_window": 80,
  "plot_x_axis": "episodes",
  "step_log_throttle": 10,
  "checkpoint_interval": 0
}
